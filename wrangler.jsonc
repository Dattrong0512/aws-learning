{
  // Website chỉ đọc; giữ KV cũ để bảo toàn dữ liệu.
  "name": "aws-learning",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/Exam", "/Exam/*", "/all", "/all.html"]
  },
  "build": { "command": "node tools/build-site.mjs" },
  "kv_namespaces": [
    {
      "binding": "SR",
      "id": "d946c6f1e85f4656b2781cb3939fb656",
      // Giữ nguyên KV namespace hiện có để bảo toàn dữ liệu đã lưu (content-v1)
      // và đồng bộ nội dung giữa các máy.
      "preview_id": "d946c6f1e85f4656b2781cb3939fb656",
      "remote": true
    }
  ],
  "dev": {
    // Serve the local site on 8788 (avoids a clash with another process on 8787).
    "port": 8788
  },
  "observability": { "enabled": true }
}
